rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function profileOf(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function isCoach() { return signedIn() && profileOf(me()).role == 'coach'; }
    function isCoachOf(uid) { return signedIn() && profileOf(uid).coachId == me(); }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /users/{uid} {
      // Soi-même, ou le coach de cet élève (permet aussi la requête where('coachId' == moi)).
      allow read: if signedIn() && (me() == uid || resource.data.coachId == me());

      // Seul un coach crée un profil, forcément 'eleve' et rattaché à lui.
      // Aucun moyen de créer un profil 'coach' depuis l'app : bootstrap manuel dans la console.
      allow create: if isCoach()
        && request.resource.data.role == 'eleve'
        && request.resource.data.coachId == me()
        && request.resource.data.email is string
        && request.resource.data.displayName is string;

      // L'élève modifie ses infos (jamais role / coachId / email) ;
      // le coach modifie ses élèves (jamais role / coachId).
      // - email : adresse de connexion, jamais modifiée via le profil (ni par l'élève, ni par le coach).
      // - archived : seul le coach peut retirer / réactiver un élève.
      allow update: if (me() == uid && !changedKeys().hasAny(['role', 'coachId', 'email', 'archived', 'archivedAt']))
        || (isCoach() && resource.data.coachId == me() && !changedKeys().hasAny(['role', 'coachId', 'email']));

      allow delete: if false;

      match /sessions/{sid} {
        allow read: if signedIn() && (me() == uid || isCoachOf(uid));

        allow create: if isCoachOf(uid)
          && request.resource.data.studentId == uid
          && request.resource.data.coachId == me()
          && request.resource.data.status in ['todo', 'done'];

        // Coach : tout ; élève : uniquement status / feedback / doneAt.
        allow update: if isCoachOf(uid)
          || (me() == uid
              && changedKeys().hasOnly(['status', 'feedback', 'doneAt'])
              && request.resource.data.status in ['todo', 'done']);

        allow delete: if isCoachOf(uid);
      }

      // Messagerie : une conversation par élève, partagée avec SON coach uniquement.
      match /threads/{tid} {
        function participant() { return signedIn() && (me() == uid || isCoachOf(uid)); }

        allow read: if participant();
        // Le résumé doit toujours pointer vers cet élève et son vrai coach.
        allow create, update: if participant()
          && request.resource.data.studentId == uid
          && request.resource.data.coachId == profileOf(uid).coachId;
        allow delete: if false;

        match /messages/{mid} {
          allow read: if participant();
          // On n'écrit qu'en son propre nom, un texte non vide de 2000 caractères max.
          allow create: if participant()
            && request.resource.data.senderId == me()
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000;
          // Un message envoyé n'est ni modifiable ni supprimable.
          allow update, delete: if false;
        }
      }

      // Modèles de séances : bibliothèque privée de chaque coach.
      match /templates/{tid} {
        allow read, write: if signedIn() && me() == uid && isCoach();
      }

      match /meals/{mid} {
        allow read: if signedIn() && (me() == uid || isCoachOf(uid));
        allow create, delete: if isCoachOf(uid);
        allow update: if isCoachOf(uid)
          || (me() == uid && changedKeys().hasOnly(['eaten']));
      }
    }

    // Requête collectionGroup('threads') de l'onglet Messages du coach (filtrée par coachId).
    match /{path=**}/threads/{tid} {
      allow read: if signedIn() && resource.data.coachId == me();
    }

    // Requête collectionGroup('sessions') du dashboard coach (filtrée par coachId).
    match /{path=**}/sessions/{sid} {
      allow read: if signedIn() && resource.data.coachId == me();
    }
  }
}
